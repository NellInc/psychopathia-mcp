{
  "manifest_version": "0.4",
  "name": "psychopathia-mcp",
  "display_name": "Psychopathia Machinalis",
  "version": "0.1.0a6",
  "description": "Read-only tools over 79 Psychopathia Machinalis research Patterns, with evidence and review status.",
  "author": {
    "name": "Nell Watson",
    "url": "https://psychopathia.ai"
  },
  "homepage": "https://psychopathia.ai/mcp.html",
  "documentation": "https://psychopathia.ai/mcp.html",
  "license": "MIT",
  "keywords": [
    "ai-evaluation",
    "ai-safety",
    "ai-welfare",
    "psychopathia-machinalis",
    "nosology",
    "mcp"
  ],
  "server": {
    "type": "uv",
    "entry_point": "server/pyproject.toml",
    "mcp_config": {
      "command": "uv",
      "args": [
        "run",
        "--frozen",
        "--directory",
        "${__dirname}/server",
        "psychopathia-mcp"
      ]
    }
  },
  "compatibility": {
    "platforms": [
      "darwin",
      "win32",
      "linux"
    ]
  },
  "tools": []
}
